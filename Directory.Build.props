<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Product>Storava</Product>
    <Company>Storava</Company>
    <Version>1.0.0</Version>
    <Description>Storage Intelligence &amp; Advisor — explains why your disk is full and proposes a safe plan to reclaim it.</Description>
    <Copyright>Copyright © Storava</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
