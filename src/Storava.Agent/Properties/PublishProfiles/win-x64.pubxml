<?xml version="1.0" encoding="utf-8"?>
<!--
  How the Agent ships: one file, no prerequisites.

  Self-contained on purpose. Connecting a computer should not begin with "first install the .NET
  runtime" — the Agent exists to make the browser edition usable, and a prerequisite would put a
  second obstacle in front of the first.

  Trimming is deliberately off. The Agent reflects over EF Core and Serilog sinks, and a trimmed
  build that starts fine and fails at the first scan would be worse than a larger download.

    dotnet publish src/Storava.Agent/Storava.Agent.csproj -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- Referenced projects would otherwise drop their own .pdb files beside the single
         file, which rather defeats calling it a single file. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\agent\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
