<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-targeted so the Agent can reuse the same DPAPI secret store and, from the next
         stage, the same disk scanner the desktop app runs. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Storava.Agent</RootNamespace>
    <AssemblyName>storava-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Storava.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel, bound to loopback only. The Agent serves the browser on this machine; it is not
         reachable from the network and never dials out except to pair. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storava.Application\Storava.Application.csproj" />
    <!-- The Agent walks the disk with the desktop scanner, classifies with the desktop rule
         catalog, and stores results in the desktop's SQLite shape. None of it is reimplemented. -->
    <ProjectReference Include="..\Storava.Infrastructure\Storava.Infrastructure.csproj" />
    <!-- The execution guard and the copy-verify-recycle ordering, reused rather than rebuilt. -->
    <ProjectReference Include="..\Storava.Migrations\Storava.Migrations.csproj" />
    <ProjectReference Include="..\Storava.Platform\Storava.Platform.csproj" />
    <ProjectReference Include="..\Storava.Rules\Storava.Rules.csproj" />
  </ItemGroup>

</Project>
