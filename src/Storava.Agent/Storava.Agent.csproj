<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the Agent's normal life is a tray icon, and a console window flashing up
         at every logon would be its most visible feature. The command-line verbs still print by
         attaching to the terminal that launched them. -->
    <OutputType>WinExe</OutputType>
    <!-- Windows-targeted so the Agent can reuse the same DPAPI secret store and the same disk
         scanner the desktop app runs. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Storava.Agent</RootNamespace>
    <AssemblyName>storava-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>storava-agent.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shipping settings live in Properties/PublishProfiles/win-x64.pubxml rather than here.
         A RuntimeIdentifier in the project file would make every ordinary build and every
         referencing test project architecture-specific, for a setting only publishing needs. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Storava.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel, bound to loopback only. The Agent serves the browser on this machine; it is not
         reachable from the network and never dials out except to pair. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- Running from the tray there is no console, so a failure at logon needs somewhere to land. -->
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storava.Application\Storava.Application.csproj" />
    <!-- The Agent walks the disk with the desktop scanner, classifies with the desktop rule
         catalog, and stores results in the desktop's SQLite shape. None of it is reimplemented. -->
    <ProjectReference Include="..\Storava.Infrastructure\Storava.Infrastructure.csproj" />
    <!-- The execution guard and the copy-verify-recycle ordering, reused rather than rebuilt. -->
    <ProjectReference Include="..\Storava.Migrations\Storava.Migrations.csproj" />
    <ProjectReference Include="..\Storava.Platform\Storava.Platform.csproj" />
    <ProjectReference Include="..\Storava.Rules\Storava.Rules.csproj" />
  </ItemGroup>

</Project>
