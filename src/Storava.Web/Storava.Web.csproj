<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Storava.Web</RootNamespace>
    <AssemblyName>Storava.Web</AssemblyName>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <Target Name="BuildClientAssets" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(BuildClientAssets)' != 'false'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build" />
  </Target>

</Project>
