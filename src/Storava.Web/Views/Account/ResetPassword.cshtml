@model Storava.Web.Models.ResetPasswordViewModel
@inject IStringLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["AccountResetTitle"];
    var succeeded = ViewData["PasswordResetSucceeded"] as bool? == true;
}

<main class="account-page">
    <section class="account-intro">
        <a class="account-wordmark" asp-controller="Home" asp-action="Index">Storava</a>
        <div class="account-intro-copy">
            <span class="account-kicker">@T["AccountSecurity"]</span>
            <h1>@T["AccountResetTitle"]</h1>
            <p>@T["AccountPasswordHint"]</p>
        </div>
    </section>
    <section class="account-panel">
        <div class="account-card">
            @if (succeeded)
            {
                <div class="account-status-mark" aria-hidden="true">✓</div>
                <h2>@T["AccountResetSuccess"]</h2>
                <a class="account-inline-link" asp-action="Login">@T["AccountBackToLogin"]</a>
            }
            else
            {
                <h2>@T["AccountResetTitle"]</h2>
                <p>@T["AccountPasswordHint"]</p>
                <form class="account-form" method="post">
                    <input asp-for="UserId" type="hidden" />
                    <input asp-for="Code" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="account-validation"></div>
                    <div class="account-field">
                        <label asp-for="Password">@T["AccountPassword"]</label>
                        <input asp-for="Password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="account-validation"></span>
                    </div>
                    <div class="account-field">
                        <label asp-for="ConfirmPassword">@T["AccountConfirmPassword"]</label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="account-validation"></span>
                    </div>
                    <button class="account-button" type="submit">@T["AccountResetButton"]</button>
                </form>
            }
        </div>
    </section>
</main>
