<Window x:Class="Storava.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Storava"
        Height="820" Width="1280" MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource App.FontFamily}"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource Storava.Brush.Hero}">
                            <materialDesign:PackIcon Kind="HarddiskPlus" Width="22" Height="22"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str.App.Name}"
                                       FontFamily="{DynamicResource App.FontFamily}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource Str.App.Tagline}" Style="{StaticResource Storava.Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav list -->
                <ListBox x:Name="NavList"
                         ItemsSource="{Binding NavItemsView}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         AutomationProperties.Name="{DynamicResource Str.Shell.Navigation}"
                         Margin="0,4,0,12">
                    <ListBox.ItemContainerStyle>
                        <!-- Without this a screen reader announces the item's type name, because the
                             label lives inside the template rather than on the container. -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Storava.NavItem}">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{Binding TitleResourceKey, Converter={StaticResource Conv.LocKey}}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding TitleResourceKey, Converter={StaticResource Conv.LocKey}}"
                                           FontFamily="{DynamicResource App.FontFamily}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Conv.LocKey}}"
                                               Style="{StaticResource Storava.SectionLabel}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <DockPanel Grid.Column="1">
            <!-- Top bar -->
            <Border DockPanel.Dock="Top" Height="60" Padding="20,0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleLanguageCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Height="36" Padding="14,0" Margin="0,0,10,0"
                                ToolTip="{DynamicResource Str.Shell.ToggleLanguage}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Translate" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Str.Shell.ToggleLanguage}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="{DynamicResource Str.Shell.ToggleTheme}">
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="22" Height="22" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host.
                 The indicator lives here rather than on each page so that no page can be added
                 without one. It sits over the page instead of replacing it, so returning to a
                 page you have already seen keeps showing it while the newer data is fetched. -->
            <Grid>
                <ContentControl Content="{Binding CurrentPage}" />

                <Border Style="{StaticResource Storava.LoadingVeil}"
                        Visibility="{Binding CurrentPage.IsLoading, Converter={StaticResource Conv.BoolVis}, FallbackValue=Collapsed}">
                    <StackPanel Style="{StaticResource Storava.LoadingCard}">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0" IsIndeterminate="True" Width="34" Height="34" />
                        <TextBlock Style="{StaticResource Storava.Text.Body}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="{Binding CurrentPage.LoadingMessageKey, Converter={StaticResource Conv.LocKeyOrDefault}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
