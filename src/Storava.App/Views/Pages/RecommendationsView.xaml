<UserControl x:Class="Storava.App.Views.Pages.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str.Recommendations.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.Recommendations.Subtitle}" Style="{StaticResource Storava.Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="16,0"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource Conv.InvBool}}"
                    Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Str.Recommendations.Analyze}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Str.Recommendations.Analyzing}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Summary + safety note -->
        <Grid Grid.Row="1" Margin="0,0,0,16"
              Visibility="{Binding HasRecommendations, Converter={StaticResource Conv.BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Storava.Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalReclaimableText}" Style="{StaticResource Storava.Text.H1}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="{DynamicResource Str.Recommendations.TotalReclaimable}" Style="{StaticResource Storava.Text.Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Storava.Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Recommendations.Count}" Style="{StaticResource Storava.Text.H1}" />
                    <TextBlock Text="{DynamicResource Str.Recommendations.Count}" Style="{StaticResource Storava.Text.Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Storava.Card}" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="24" Height="24" VerticalAlignment="Top"
                                             Margin="0,2,12,0" Foreground="{DynamicResource Storava.Brush.Success}" />
                    <TextBlock Text="{DynamicResource Str.Recommendations.SafetyNote}" Style="{StaticResource Storava.Text.Caption}"
                               MaxWidth="620" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Empty states -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource Conv.InvBoolVis}}">
            <materialDesign:PackIcon Kind="LightbulbOutline" Width="52" Height="52" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6" />
            <TextBlock TextAlignment="Center" Margin="0,12,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Storava.Text.Body}">
                        <Setter Property="Text" Value="{DynamicResource Str.Recommendations.Empty}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSession}" Value="True">
                                <Setter Property="Text" Value="{DynamicResource Str.Recommendations.NoneFound}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                <Setter Property="Text" Value="{DynamicResource Str.Recommendations.Analyzing}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRecommendations, Converter={StaticResource Conv.BoolVis}}">
            <ItemsControl ItemsSource="{Binding Recommendations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card UniformCornerRadius="14" Padding="22" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: identity, reason, methods -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <!-- Title row -->
                                    <Grid Style="{StaticResource Storava.TitleRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource Storava.TitleRow.Text}" />
                                        <WrapPanel Grid.Column="1" Style="{StaticResource Storava.TitleRow.Tags}">
                                            <Border Style="{StaticResource Storava.Badge.Risk}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding RiskText}" Style="{StaticResource Storava.Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Storava.Badge}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Storava.Badge.Text}" />
                                            </Border>
                                        </WrapPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Storava.Text.Caption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Storava.Text.Body}" Margin="0,0,0,12" />

                                    <!-- Capability chips -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource Storava.Badge}" Margin="0,0,6,0"
                                                Background="{DynamicResource MaterialDesignChipBackground}"
                                                Visibility="{Binding CanRegenerate, Converter={StaticResource Conv.BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Autorenew" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{DynamicResource Str.Recommendations.CanRegenerate}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Storava.Badge}" Margin="0,0,6,0"
                                                Background="{DynamicResource MaterialDesignChipBackground}"
                                                Visibility="{Binding CanMove, Converter={StaticResource Conv.BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{DynamicResource Str.Recommendations.CanMove}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Storava.Badge}"
                                                Background="{DynamicResource MaterialDesignChipBackground}"
                                                Visibility="{Binding CanDelete, Converter={StaticResource Conv.BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{DynamicResource Str.Recommendations.CanDelete}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Official method -->
                                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                            Background="{DynamicResource MaterialDesignChipBackground}"
                                            Visibility="{Binding OfficialMigrationHint, Converter={StaticResource Conv.NullVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <materialDesign:PackIcon Kind="CheckDecagramOutline" Width="16" Height="16" VerticalAlignment="Center"
                                                                         Margin="0,0,6,0" Foreground="{DynamicResource Storava.Brush.Success}" />
                                                <TextBlock Text="{DynamicResource Str.Recommendations.OfficialMethod}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding OfficialMigrationHint}" Style="{StaticResource Storava.Text.Caption}" />
                                            <TextBlock Text="{DynamicResource Str.Recommendations.Fallback}" Style="{StaticResource Storava.Text.Caption}"
                                                       Opacity="0.7" Margin="0,4,0,0"
                                                       Visibility="{Binding HasFallbackOnly, Converter={StaticResource Conv.BoolVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Warning -->
                                    <Border CornerRadius="8" Padding="12,10" Background="#22F59E0B"
                                            Visibility="{Binding HasWarning, Converter={StaticResource Conv.BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" VerticalAlignment="Top"
                                                                     Margin="0,2,8,0" Foreground="{DynamicResource Storava.Brush.Warning}" />
                                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Storava.Text.Caption}" MaxWidth="560" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: size + actions -->
                                <StackPanel Grid.Column="1" MinWidth="140" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Storava.Text.H1}"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBlock Text="{DynamicResource Str.Recommendations.Reclaimable}" Style="{StaticResource Storava.Text.Caption}"
                                               HorizontalAlignment="Right" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Str.Recommendations.Confidence}" Style="{StaticResource Storava.Text.Caption}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConfidenceText}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Margin="0,16,0,0" HorizontalAlignment="Right" Height="34" Padding="14,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{DynamicResource Str.Recommendations.OpenFolder}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
