<UserControl x:Class="Storava.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Pad.Page}" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.Settings.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.Settings.Subtitle}" Style="{StaticResource Storava.Text.Caption}" Margin="0,4,0,18" />

                <!-- Appearance -->
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.Appearance}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Str.Settings.Language}" Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Conv.LangName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Str.Settings.Theme}" Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Conv.ThemeName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str.Settings.Accent}" Style="{StaticResource Storava.Text.Caption}" Margin="0,18,0,8" />
                        <ItemsControl ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Padding="0"
                                            Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="{Binding Converter={StaticResource Conv.Hex}}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- AI -->
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.Ai.Section}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,12" />

                        <ToggleButton IsChecked="{Binding AiEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      HorizontalAlignment="Left" Content="{DynamicResource Str.Settings.Ai.Enable}"
                                      Margin="0,0,0,16" />

                        <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.Model}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,4"
                                 IsEnabled="{Binding AiEnabled}" />
                        <TextBlock Text="{DynamicResource Str.Settings.Ai.ModelHint}" Style="{StaticResource Storava.Text.Caption}"
                                   TextWrapping="Wrap" Margin="2,0,0,14" />
                        <TextBox Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.BaseUrl}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsEnabled="{Binding AiEnabled}" />

                        <!-- API key. Handled in code-behind so the plaintext never reaches a binding. -->
                        <TextBlock Text="{DynamicResource Str.Settings.Ai.ApiKey}" Style="{StaticResource Storava.SectionLabel}"
                                   Margin="0,20,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         materialDesign:HintAssist.Hint="sk-or-v1-…" FlowDirection="LeftToRight" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Height="40" Padding="16,0" VerticalAlignment="Center"
                                    Click="OnSaveApiKey" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="{DynamicResource Str.Settings.Ai.ApiKey.Save}" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Height="40" Padding="16,0" VerticalAlignment="Center"
                                    Command="{Binding RemoveApiKeyCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="{DynamicResource Str.Settings.Ai.ApiKey.Remove}"
                                    IsEnabled="{Binding HasApiKey}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                            <materialDesign:PackIcon VerticalAlignment="Center" Margin="0,0,6,0" Width="16" Height="16">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="KeyOutline" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                                <Setter Property="Kind" Value="CheckCircle" />
                                                <Setter Property="Foreground" Value="{DynamicResource Storava.Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Storava.Text.Caption}">
                                        <Setter Property="Text" Value="{DynamicResource Str.Settings.Ai.ApiKey.NotSet}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Str.Settings.Ai.ApiKey.Set}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.Ai.ApiKey.Hint}" Style="{StaticResource Storava.Text.Caption}"
                                   TextWrapping="Wrap" MaxWidth="700" Margin="2,6,0,0" />

                        <!-- Request tuning -->
                        <UniformGrid Columns="4" Margin="0,20,0,0">
                            <TextBox Text="{Binding AiTemperature, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.Temperature}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" IsEnabled="{Binding AiEnabled}" />
                            <TextBox Text="{Binding AiMaxTokens, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.MaxTokens}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" IsEnabled="{Binding AiEnabled}" />
                            <TextBox Text="{Binding AiTimeoutSeconds, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"
                                     materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.Timeout}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" IsEnabled="{Binding AiEnabled}" />
                            <TextBox Text="{Binding AiRetryCount, UpdateSourceTrigger=LostFocus}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.Retries}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" IsEnabled="{Binding AiEnabled}" />
                        </UniformGrid>

                        <!-- Privacy -->
                        <TextBlock Text="{DynamicResource Str.Settings.Ai.Privacy}" Style="{StaticResource Storava.SectionLabel}"
                                   Margin="0,22,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="LockCheckOutline" VerticalAlignment="Center" Width="16" Height="16"
                                                     Margin="0,0,6,0" Foreground="{DynamicResource Storava.Brush.Success}" />
                            <TextBlock Text="{DynamicResource Str.Settings.Ai.SanitizedOnly}"
                                       Style="{StaticResource Storava.Text.Body}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding AiAllowUnknownFolders}" Margin="0,0,0,8"
                                  Content="{DynamicResource Str.Settings.Ai.AllowUnknown}" />
                        <CheckBox IsChecked="{Binding AiAllowReportGeneration}"
                                  Content="{DynamicResource Str.Settings.Ai.AllowReports}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <materialDesign:PackIcon Kind="ShieldLockOutline" VerticalAlignment="Top" Margin="0,2,8,0"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="{DynamicResource Str.Settings.Ai.Note}"
                                       Style="{StaticResource Storava.Text.Caption}" MaxWidth="680" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Save -->
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10" Height="42" Padding="22,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.Settings.Save}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                Visibility="{Binding IsSaved, Converter={StaticResource Conv.BoolVis}}">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="{DynamicResource Storava.Brush.Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Settings.Saved}" Style="{StaticResource Storava.Text.Body}"
                                   Foreground="{DynamicResource Storava.Brush.Success}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
