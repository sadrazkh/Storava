<UserControl x:Class="Storava.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Pad.Page}" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.Settings.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.Settings.Subtitle}" Style="{StaticResource Storava.Text.Caption}" Margin="0,4,0,18" />

                <!-- Appearance -->
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.Appearance}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Str.Settings.Language}" Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Conv.LangName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Str.Settings.Theme}" Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource Conv.ThemeName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str.Settings.Accent}" Style="{StaticResource Storava.Text.Caption}" Margin="0,18,0,8" />
                        <ItemsControl ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Padding="0"
                                            Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="{Binding Converter={StaticResource Conv.Hex}}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- AI -->
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.Ai.Section}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,12" />

                        <ToggleButton IsChecked="{Binding AiEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      HorizontalAlignment="Left" Content="{DynamicResource Str.Settings.Ai.Enable}"
                                      Margin="0,0,0,16" />

                        <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.Model}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,14"
                                 IsEnabled="{Binding AiEnabled}" />
                        <TextBox Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Settings.Ai.BaseUrl}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsEnabled="{Binding AiEnabled}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <materialDesign:PackIcon Kind="ShieldLockOutline" VerticalAlignment="Top" Margin="0,2,8,0"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="{DynamicResource Str.Settings.Ai.Note}"
                                       Style="{StaticResource Storava.Text.Caption}" MaxWidth="680" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Save -->
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10" Height="42" Padding="22,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.Settings.Save}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                Visibility="{Binding IsSaved, Converter={StaticResource Conv.BoolVis}}">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="{StaticResource Storava.Brush.Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Settings.Saved}" Style="{StaticResource Storava.Text.Body}"
                                   Foreground="{StaticResource Storava.Brush.Success}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
