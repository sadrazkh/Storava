<UserControl x:Class="Storava.App.Views.Pages.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">
    <!-- Stretch, not Left.

         Left makes the Grid size itself to its widest child, and its widest child is the path
         currently being walked — a string that changes several times a second. Every one of those
         changes resized the whole page, so the five metric tiles grew and shrank continuously
         while the scan ran. Stretching decouples the layout from the data: the tiles are the same
         width at the first file as at the millionth. -->
    <Grid Margin="{StaticResource Pad.Page}" MaxWidth="1100" HorizontalAlignment="Stretch">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" HorizontalAlignment="Stretch">
                <!-- Spinner stops while paused so the visual state matches reality. -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="{Binding Controller.IsPaused, Converter={StaticResource Conv.InvBool}}"
                             Value="100" Width="34" Height="34" VerticalAlignment="Center"
                             Visibility="{Binding IsComplete, Converter={StaticResource Conv.InvBoolVis}}" />
                <materialDesign:PackIcon Kind="CheckCircle" Width="34" Height="34" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Storava.Brush.Success}"
                                         Visibility="{Binding IsComplete, Converter={StaticResource Conv.BoolVis}}" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsComplete, Converter={StaticResource Conv.InvBoolVis}}">
                        <TextBlock Text="{DynamicResource Str.Progress.Title}"
                                   Style="{StaticResource Storava.Text.H1}" />
                        <Border Style="{StaticResource Storava.Badge.Warning}" Margin="12,0,0,0"
                                Visibility="{Binding Controller.IsPaused, Converter={StaticResource Conv.BoolVis}}">
                            <TextBlock Text="{DynamicResource Str.Progress.Paused}" Style="{StaticResource Storava.Badge.Text}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str.Progress.Complete}"
                               Style="{StaticResource Storava.Text.H1}"
                               Visibility="{Binding IsComplete, Converter={StaticResource Conv.BoolVis}}" />
                    <!-- Trims inside whatever room it is given rather than asking for more. -->
                    <TextBlock Text="{Binding Controller.CurrentPath}" Style="{StaticResource Storava.Text.Caption}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding IsComplete, Converter={StaticResource Conv.InvBoolVis}}" />
                </StackPanel>
            </StackPanel>

            <!-- Metric tiles -->
            <UniformGrid Columns="5" Margin="0,0,0,18">
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Controller.FilesScanned}" Style="{StaticResource Storava.Text.H1}" />
                        <TextBlock Text="{DynamicResource Str.Progress.Files}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="6,0,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Controller.FoldersScanned}" Style="{StaticResource Storava.Text.H1}" />
                        <TextBlock Text="{DynamicResource Str.Progress.Folders}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="6,0,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Controller.BytesText}" Style="{StaticResource Storava.Text.H1}" />
                        <TextBlock Text="{DynamicResource Str.Progress.Size}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="6,0,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Controller.ElapsedText}" Style="{StaticResource Storava.Text.H1}" />
                        <TextBlock Text="{DynamicResource Str.Progress.Elapsed}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="6,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Controller.ErrorCount}" Style="{StaticResource Storava.Text.H1}" />
                        <TextBlock Text="{DynamicResource Str.Progress.Errors}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Controls while running -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding Controller.IsRunning, Converter={StaticResource Conv.BoolVis}}">
                <Button Command="{Binding PauseCommand}" Height="42" Padding="20,0" Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Visibility="{Binding Controller.IsPaused, Converter={StaticResource Conv.InvBoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pause" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Progress.Pause}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ResumeCommand}" Height="42" Padding="20,0" Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding Controller.IsPaused, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Progress.Resume}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}" Height="42" Padding="20,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource Storava.Brush.Danger}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Progress.Cancel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Completed -->
            <Border Style="{StaticResource Storava.Card}"
                    Visibility="{Binding IsComplete, Converter={StaticResource Conv.BoolVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Progress.CompleteDesc}" Style="{StaticResource Storava.Text.Body}" Margin="0,0,0,14" />
                    <Button HorizontalAlignment="Left" Command="{Binding ViewResultsCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10" Height="44" Padding="24,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderSearchOutline" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str.Progress.ViewResults}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
