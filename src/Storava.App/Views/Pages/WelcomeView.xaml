<UserControl x:Class="Storava.App.Views.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1040" Margin="{StaticResource Pad.Page}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero -->
            <Border Grid.Row="0" CornerRadius="{StaticResource Radius.Card}"
                    Background="{DynamicResource Storava.Brush.Hero}" Padding="32,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="12" Background="#22FFFFFF">
                            <materialDesign:PackIcon Kind="HarddiskPlus" Width="26" Height="26"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="White" />
                        </Border>
                        <StackPanel Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str.App.Name}"
                                       FontFamily="{DynamicResource App.FontFamily}"
                                       FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{DynamicResource Str.App.Tagline}"
                                       FontFamily="{DynamicResource App.FontFamily}"
                                       FontSize="12" Foreground="#CCFFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Str.Welcome.Title}"
                               FontFamily="{DynamicResource App.FontFamily}"
                               FontSize="30" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" Margin="0,22,0,8" />
                    <TextBlock Text="{DynamicResource Str.Welcome.Subtitle}"
                               FontFamily="{DynamicResource App.FontFamily}"
                               FontSize="15" Foreground="#E6FFFFFF" TextWrapping="Wrap" MaxWidth="640"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Safety notice -->
            <Border Grid.Row="1" Style="{StaticResource Storava.Card}" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource MaterialDesignSelection}">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="26" Height="26"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Storava.Brush.Success}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{DynamicResource Str.Welcome.Safety.Title}"
                                   Style="{StaticResource Storava.Text.H2}" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Safety.Body}"
                                   Style="{StaticResource Storava.Text.Body}"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Feature cards -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,18,0,0">
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Radar" Width="30" Height="30"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Feature1.Title}"
                                   Style="{StaticResource Storava.Text.H2}" Margin="0,12,0,4" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Feature1.Body}"
                                   Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="8,0,8,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="30" Height="30"
                                                 Foreground="{DynamicResource Storava.Brush.Warning}" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Feature2.Title}"
                                   Style="{StaticResource Storava.Text.H2}" Margin="0,12,0,4" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Feature2.Body}"
                                   Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="30" Height="30"
                                                 Foreground="{DynamicResource Storava.Brush.Success}" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Feature3.Title}"
                                   Style="{StaticResource Storava.Text.H2}" Margin="0,12,0,4" />
                        <TextBlock Text="{DynamicResource Str.Welcome.Feature3.Body}"
                                   Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick setup + start -->
            <Border Grid.Row="3" Style="{StaticResource Storava.Card}" Margin="0,18,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.Welcome.Language}"
                                   Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,4" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource Conv.LangName}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{DynamicResource Str.Welcome.Theme}"
                                   Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,4" />
                        <ToggleButton IsChecked="{Binding IsDarkTheme}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      HorizontalAlignment="Left" />
                    </StackPanel>

                    <Button Grid.Column="3" VerticalAlignment="Center"
                            Command="{Binding GetStartedCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Height="44" Padding="24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.Welcome.Start}" VerticalAlignment="Center" />
                            <materialDesign:PackIcon Kind="ArrowRight" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
