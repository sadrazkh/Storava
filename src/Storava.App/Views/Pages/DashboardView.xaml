<UserControl x:Class="Storava.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1040">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Pad.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Dashboard.Title}" Style="{StaticResource Storava.Text.Display}" />
                    <TextBlock Text="{DynamicResource Str.Dashboard.Subtitle}" Style="{StaticResource Storava.Text.Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding StartScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10" Height="42" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Str.Dashboard.StartScan}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Metrics -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Database" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="24" Height="24" />
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Storava.Text.Metric}" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource Str.Dashboard.Metric.Total}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="8,0,8,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ChartArc" Foreground="{StaticResource Storava.Brush.Warning}" Width="24" Height="24" />
                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Storava.Text.Metric}" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource Str.Dashboard.Metric.Used}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="8,0,8,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{StaticResource Storava.Brush.Success}" Width="24" Height="24" />
                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Storava.Text.Metric}" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource Str.Dashboard.Metric.Free}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Storava.Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Harddisk" Foreground="{DynamicResource MaterialDesignBodyLight}" Width="24" Height="24" />
                        <TextBlock Text="{Binding DriveCount}" Style="{StaticResource Storava.Text.Metric}" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource Str.Dashboard.Metric.Drives}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Body: drives + side panels -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Drives -->
                <Border Grid.Column="0" Style="{StaticResource Storava.Card}" Margin="0,0,8,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Dashboard.Drives.Title}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <materialDesign:PackIcon Kind="Harddisk" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Storava.Text.Body}" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Storava.Text.Caption}">
                                                <Run Text="{Binding UsedText, Mode=OneWay}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding TotalText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <Grid Grid.Row="1">
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}"
                                                         Height="7" Background="{DynamicResource MaterialDesignDivider}"
                                                         Foreground="{Binding BarColor, Converter={StaticResource Conv.Hex}}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Side panels -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <!-- AI status -->
                    <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RobotOutline" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Str.Dashboard.Ai.Title}" Style="{StaticResource Storava.Text.H2}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Str.Dashboard.Ai.Disabled}"
                                       Style="{StaticResource Storava.Text.Caption}" Margin="0,8,0,0"
                                       Visibility="{Binding AiEnabled, Converter={StaticResource Conv.InvBoolVis}}" />
                            <TextBlock Text="{DynamicResource Str.Dashboard.Ai.Enabled}"
                                       Style="{StaticResource Storava.Text.Body}"
                                       Foreground="{StaticResource Storava.Brush.Success}" Margin="0,8,0,0"
                                       Visibility="{Binding AiEnabled, Converter={StaticResource Conv.BoolVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Last scan (empty state) -->
                    <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Dashboard.LastScan.Title}" Style="{StaticResource Storava.Text.H2}" />
                            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Magnify" Width="34" Height="34" HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6" />
                                <TextBlock Text="{DynamicResource Str.Dashboard.LastScan.Empty}"
                                           Style="{StaticResource Storava.Text.Caption}" TextAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Findings (empty state) -->
                    <Border Style="{StaticResource Storava.Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Dashboard.Findings.Title}" Style="{StaticResource Storava.Text.H2}" />
                            <TextBlock Text="{DynamicResource Str.Dashboard.Findings.Empty}"
                                       Style="{StaticResource Storava.Text.Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
