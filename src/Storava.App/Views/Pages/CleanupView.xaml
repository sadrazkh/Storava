<UserControl x:Class="Storava.App.Views.Pages.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300">

    <!--
        Three steps, one at a time, with the primary action always in the same corner.

        Everything used to be on screen together: a list, a destination card, a check card and a
        confirmation card, each with its own button. There was no obvious place to start and no
        obvious place to go next. Now the page asks one question at a time, and the button that
        moves you forward never moves.
    -->
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str.Cleanup.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.Cleanup.Subtitle}" Style="{StaticResource Storava.Text.Caption}"
                           TextWrapping="Wrap" MaxWidth="720" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Which scan is being worked on. A picker only when there is a choice to make. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="260" MaxWidth="420">
                <ComboBox ItemsSource="{Binding Scans}" SelectedItem="{Binding SelectedScan}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{DynamicResource Str.Cleanup.Scan}"
                          Visibility="{Binding HasSeveralScans, Converter={StaticResource Conv.BoolVis}}" />
                <TextBlock Text="{Binding RootPathText}" Style="{StaticResource Storava.Text.Caption}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,6,0,0"
                           Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}" />
            </StackPanel>
        </Grid>

        <!-- ============================ Steps ============================ -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Phases}" Margin="0,0,0,18"
                      Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Storava.Step}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Storava.Step.Number}">
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Storava.Step.NumberText}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Storava.Step.Text}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================ Nothing to work with ============================ -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding HasSession, Converter={StaticResource Conv.InvBoolVis}}">
            <materialDesign:PackIcon Kind="Broom" Width="52" Height="52" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6" />
            <TextBlock Text="{DynamicResource Str.Cleanup.Empty}" Style="{StaticResource Storava.Text.Body}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </StackPanel>

        <!-- ============================ Step 1 — choose ============================ -->
        <Grid Grid.Row="2" Visibility="{Binding IsChoosing, Converter={StaticResource Conv.BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="{DynamicResource Str.Cleanup.Search}"
                         Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding SuggestedOnly}" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource Str.Cleanup.SuggestedOnly}" VerticalAlignment="Center"
                               Style="{StaticResource Storava.Text.Body}" Margin="0,0,16,0" />

                    <Button Command="{Binding SelectSuggestedCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="38" Padding="14,0" Margin="0,0,8,0"
                            Content="{DynamicResource Str.Cleanup.SelectSuggested}" />
                    <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                            Height="38" Padding="12,0" IsEnabled="{Binding HasSelection}"
                            Content="{DynamicResource Str.Cleanup.ClearSelection}" />
                </StackPanel>
            </Grid>

            <!-- Filter by the same tags the rows carry. Nothing selected means no opinion,
                 which shows everything. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Top"
                        Visibility="{Binding HasRiskFilters, Converter={StaticResource Conv.BoolVis}}">
                <TextBlock Text="{DynamicResource Str.Cleanup.FilterBy}" VerticalAlignment="Center"
                           Style="{StaticResource Storava.Text.Caption}" Margin="0,0,10,0" />

                <ItemsControl ItemsSource="{Binding RiskFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The content is two text blocks, which leaves a screen reader with
                                 nothing to announce. The name spells the filter out. -->
                            <ToggleButton IsChecked="{Binding IsSelected}" Style="{StaticResource Storava.FilterChip}"
                                          AutomationProperties.Name="{Binding AutomationName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" Opacity="0.75" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Command="{Binding ClearRiskFiltersCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                        Height="30" Padding="8,0" VerticalAlignment="Center"
                        Content="{DynamicResource Str.Cleanup.AllRisks}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{DynamicResource Str.Cleanup.NoItems}"
                       Style="{StaticResource Storava.Text.Body}" TextWrapping="Wrap"
                       VerticalAlignment="Top" MaxWidth="560" Opacity="0.75"
                       Visibility="{Binding HasItems, Converter={StaticResource Conv.InvBoolVis}}" />

            <!--
                The list scrolls itself rather than sitting inside a ScrollViewer. A ScrollViewer
                hands its child unlimited height, so a virtualizing panel inside one is told it has
                room for everything and builds every row — three hundred of them before the page
                could appear.
            -->
            <ListBox Grid.Row="2" ItemsSource="{Binding VisibleItems}"
                     Visibility="{Binding HasItems, Converter={StaticResource Conv.BoolVis}}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Rows are chosen with their checkbox, so the ListBox must not paint a selection
                     of its own on top of them. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Storava.Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                                          IsChecked="{Binding IsSelected}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <!-- The tags take the width they need and the title gives way.
                                         The other way round is what cut "Unclassified" short. -->
                                    <Grid Style="{StaticResource Storava.TitleRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                   Style="{StaticResource Storava.TitleRow.Text}" />
                                        <WrapPanel Grid.Column="1" Style="{StaticResource Storava.TitleRow.Tags}">
                                            <Border Style="{StaticResource Storava.Badge.Risk}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding RiskText}" Style="{StaticResource Storava.Badge.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Storava.Badge}">
                                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Storava.Badge.Text}" />
                                            </Border>
                                        </WrapPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Storava.Text.Caption}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <ContentControl Content="{Binding Path}"
                                                        ContentTemplate="{StaticResource Storava.PathActions}"
                                                        Margin="4,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Storava.Text.Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85"
                                               Visibility="{Binding HasReason, Converter={StaticResource Conv.BoolVis}}" />

                                    <!-- What the AI said, beside what the rules said rather than
                                         instead of it. Marked, because one is deterministic and
                                         the other is a model's suggestion. -->
                                    <Grid Margin="0,6,0,0"
                                          Visibility="{Binding HasAiNote, Converter={StaticResource Conv.BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Storava.Badge.Info}"
                                                VerticalAlignment="Top" Margin="0,1,8,0">
                                            <TextBlock Text="{DynamicResource Str.Cleanup.AiTag}"
                                                       Style="{StaticResource Storava.Badge.Text}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding AiNote}"
                                                   Style="{StaticResource Storava.Text.Caption}" TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- A Grid, not a horizontal StackPanel: a StackPanel gives its
                                         children unlimited width, so this never wrapped and was
                                         cut off mid-sentence. -->
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding IsSuggested, Converter={StaticResource Conv.InvBoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="HelpCircleOutline"
                                                                 Width="14" Height="14" Margin="0,2,6,0"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="{DynamicResource Storava.Brush.Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding UnknownNote}"
                                                   Style="{StaticResource Storava.Text.Caption}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                                           Style="{StaticResource Storava.Text.H2}" TextWrapping="NoWrap"
                                           MinWidth="96" TextAlignment="Right" Margin="0,0,16,0" />

                                <ComboBox Grid.Column="3" VerticalAlignment="Center" MinWidth="132"
                                          ItemsSource="{Binding AvailableActions}"
                                          SelectedItem="{Binding SelectedAction}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ============================ Step 2 — destination ============================ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsPickingDestination, Converter={StaticResource Conv.BoolVis}}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Str.Cleanup.DestinationHelp}"
                           Style="{StaticResource Storava.Text.Body}" TextWrapping="Wrap" Margin="0,0,0,18" />

                <Button Command="{Binding PickDestinationRootCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Left" Height="46" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Str.Cleanup.PickDestination}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Storava.Row}" Margin="0,16,0,0"
                        Visibility="{Binding DestinationRoot, Converter={StaticResource Conv.NullVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Cleanup.Destination}"
                                   Style="{StaticResource Storava.SectionLabel}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DestinationRoot}" Style="{StaticResource Storava.Text.Body}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ Step 3 — check and run ============================ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsActing, Converter={StaticResource Conv.BoolVis}}">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,14"
                             Visibility="{Binding IsPreparing, Converter={StaticResource Conv.BoolVis}}" />

                <!-- What the dry run found -->
                <Border Style="{StaticResource Storava.Row}" Margin="0,0,0,12"
                        Visibility="{Binding HasPreflight, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ReclaimableText}" Style="{StaticResource Storava.Text.Metric}" />
                                <TextBlock Text="{DynamicResource Str.Cleanup.Measured}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding RunnableCountText}" Style="{StaticResource Storava.Text.Metric}" />
                                <TextBlock Text="{DynamicResource Str.Cleanup.Ready}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding BlockedCountText}" Style="{StaticResource Storava.Text.Metric}" />
                                <TextBlock Text="{DynamicResource Str.Cleanup.Blocked}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Storava.Badge.Warning}" Padding="12,10" Margin="0,14,0,0"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding NothingCanRun, Converter={StaticResource Conv.BoolVis}}">
                            <TextBlock Text="{DynamicResource Str.Cleanup.NothingCanRun}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Blockers}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Storava.Badge.Danger}" Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Storava.Badge.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding BlockerText}" FontSize="12" TextWrapping="Wrap"
                                                       Opacity="0.9" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The one step awaiting a decision -->
                <Border Style="{StaticResource Storava.Row}" Margin="0,0,0,12"
                        Visibility="{Binding HasCurrentStep, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource Storava.Badge.Accent}">
                                <TextBlock Text="{Binding CurrentStep.ActionText}" Style="{StaticResource Storava.Badge.Text}" />
                            </Border>
                            <TextBlock Text="{Binding CurrentStep.PositionText}" Style="{StaticResource Storava.Text.Caption}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentStep.Title}" Style="{StaticResource Storava.Text.H2}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentStep.Path}" Style="{StaticResource Storava.Text.Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CurrentStep.SizeText}" Style="{StaticResource Storava.Text.Metric}"
                                   Margin="0,10,0,0" />

                        <!-- Nothing recognises this, and the user is told before confirming. -->
                        <Border Style="{StaticResource Storava.Badge.Warning}" Margin="0,12,0,0" Padding="12,9"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding CurrentStep.HasNoRule, Converter={StaticResource Conv.BoolVis}}">
                            <TextBlock Text="{DynamicResource Str.Cleanup.NoRuleWarning}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding CurrentStep.IsMove, Converter={StaticResource Conv.BoolVis}}">
                            <TextBlock Text="{DynamicResource Str.Cleanup.StepDestination}"
                                       Style="{StaticResource Storava.SectionLabel}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StepDestination}" Style="{StaticResource Storava.Text.Body}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- What the old path will do afterwards, which is the reason the
                                 choice between the two kinds of move exists. -->
                            <TextBlock Text="{Binding CurrentStep.MethodText}" TextWrapping="Wrap"
                                       Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,8" />
                            <Button Command="{Binding PickStepDestinationCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Height="34" Padding="10,0"
                                    HorizontalAlignment="Left"
                                    Content="{DynamicResource Str.Cleanup.ChangeDestination}" />
                        </StackPanel>

                        <!-- Typing the folder's own name is the approval.

                             No fixed height on the box: the outlined Material text field reserves
                             vertical room for its floating label, and forcing a height clipped what
                             was typed into a faint sliver. -->
                        <TextBlock Style="{StaticResource Storava.Text.Body}" TextWrapping="Wrap" Margin="0,18,0,8">
                            <Run Text="{DynamicResource Str.Migration.ConfirmPrompt}" />
                            <Run Text="{Binding CurrentStep.RequiredName, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>

                        <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="15" MaxWidth="360" HorizontalAlignment="Left"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Migration.ConfirmHint}"
                                 AutomationProperties.Name="{DynamicResource Str.Migration.ConfirmPrompt}"
                                 IsEnabled="{Binding IsExecuting, Converter={StaticResource Conv.InvBool}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Command="{Binding RunStepCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="10" Height="44" Padding="24,0" Margin="0,0,10,0"
                                    Content="{DynamicResource Str.Cleanup.RunStep}" />
                            <Button Command="{Binding SkipStepCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="44" Padding="18,0"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource Conv.InvBool}}"
                                    Content="{DynamicResource Str.Migration.Skip}" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsExecuting, Converter={StaticResource Conv.BoolVis}}">
                            <ProgressBar Value="{Binding CopyFraction, Mode=OneWay}" Maximum="1" Height="4" />
                            <TextBlock Text="{Binding CopyStatusText}" Style="{StaticResource Storava.Text.Caption}" Margin="0,6,0,0" />
                            <Button Command="{Binding CancelStepCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="34" Padding="12,0" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Foreground="{DynamicResource Storava.Brush.Danger}"
                                    Content="{DynamicResource Str.Migration.CancelStep}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outcome -->
                <Border Style="{StaticResource Storava.Row}" Margin="0,0,0,12"
                        Visibility="{Binding IsFinished, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Cleanup.Done}" Style="{StaticResource Storava.Text.H2}" />
                        <TextBlock Text="{Binding FreedText}" Style="{StaticResource Storava.Text.Display}" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Str.Cleanup.Freed}" Style="{StaticResource Storava.Text.Caption}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource Storava.Badge.Success}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding CompletedCountText}" Style="{StaticResource Storava.Badge.Text}" />
                            </Border>
                            <Border Style="{StaticResource Storava.Badge.Danger}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding FailedCountText}" Style="{StaticResource Storava.Badge.Text}" />
                            </Border>
                            <Border Style="{StaticResource Storava.Badge}">
                                <TextBlock Text="{Binding SkippedCountText}" Style="{StaticResource Storava.Badge.Text}" />
                            </Border>
                        </StackPanel>

                        <Button Command="{Binding StartOverCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="42" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="20,0"
                                Content="{DynamicResource Str.Cleanup.StartOver}" />
                    </StackPanel>
                </Border>

                <!-- What has happened so far -->
                <Border Style="{StaticResource Storava.Row}" Margin="0,0,0,12"
                        Visibility="{Binding HasLog, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Migration.LogTitle}"
                                   Style="{StaticResource Storava.SectionLabel}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Style="{StaticResource Storava.Badge.Risk}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Storava.Badge.Text}" />
                                            </Border>
                                            <TextBlock Text="{Binding FreedText}" Style="{StaticResource Storava.Text.Caption}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="{Binding WasCompleted, Converter={StaticResource Conv.BoolVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Storava.Text.Body}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RecycledPath}" Style="{StaticResource Storava.Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding WasRecycled, Converter={StaticResource Conv.BoolVis}}" />
                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Storava.Text.Caption}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Storava.Brush.Warning}"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource Conv.BoolVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ Footer ============================ -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,14,0,0"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- What is selected, kept in view the whole way through: it is the number the
                     user is deciding on, and it should not vanish when the step changes. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource Storava.Text.H2}" />
                        <TextBlock Text="{DynamicResource Str.Cleanup.Items}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="{Binding SelectedSizeText}" Style="{StaticResource Storava.Text.H2}" />
                        <TextBlock Text="{DynamicResource Str.Cleanup.Reclaimable}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding HighestRiskText}" Style="{StaticResource Storava.Text.H2}" />
                        <TextBlock Text="{DynamicResource Str.Cleanup.HighestRisk}" Style="{StaticResource Storava.Text.Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Notices sit between, where they cannot be missed on the way to the button. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                    <Border Style="{StaticResource Storava.Badge.Warning}" Padding="12,8" HorizontalAlignment="Stretch"
                            Visibility="{Binding RecoveryNotice, Converter={StaticResource Conv.NullVis}}">
                        <TextBlock Text="{Binding RecoveryNotice}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource Storava.Badge.Danger}" Padding="12,8" HorizontalAlignment="Stretch"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource Conv.NullVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding BackCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                            Height="46" Padding="18,0" Margin="0,0,10,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource Conv.BoolVis}}"
                            Content="{DynamicResource Str.Cleanup.Back}" />

                    <!-- The one primary action, in the same place on every step — including the
                         last, where it is what starts the run. It steps aside only once the run is
                         under way, when the decisions become per item and belong to the
                         confirmation card. -->
                    <Button Command="{Binding NextCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="10" Height="46" Padding="28,0" MinWidth="180"
                            Visibility="{Binding IsPrimaryVisible, Converter={StaticResource Conv.BoolVis}}"
                            Content="{Binding PrimaryActionText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
