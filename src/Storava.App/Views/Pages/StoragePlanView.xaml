<UserControl x:Class="Storava.App.Views.Pages.StoragePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str.Plan.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.Plan.Subtitle}" Style="{StaticResource Storava.Text.Caption}"
                           TextWrapping="Wrap" MaxWidth="720" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            Visibility="{Binding IsSaved, Converter={StaticResource Conv.BoolVis}}">
                    <materialDesign:PackIcon Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Foreground="{DynamicResource Storava.Brush.Success}" />
                    <TextBlock Text="{DynamicResource Str.Plan.Saved}" Style="{StaticResource Storava.Text.Body}"
                               Foreground="{DynamicResource Storava.Brush.Success}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Command="{Binding ClearCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="38" Padding="16,0" Margin="0,0,8,0"
                        IsEnabled="{Binding HasSteps}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistRemove" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Plan.Clear}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10" Height="38" Padding="20,0"
                        IsEnabled="{Binding HasSteps}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Plan.Save}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The one thing the user must not misread about this page -->
        <Border Grid.Row="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
                Background="{DynamicResource MaterialDesignChipBackground}"
                Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" VerticalAlignment="Top"
                                         Margin="0,1,12,0" Foreground="{DynamicResource Storava.Brush.Success}" />
                <TextBlock Text="{DynamicResource Str.Plan.SafetyNote}" Style="{StaticResource Storava.Text.Body}"
                           TextWrapping="Wrap" MaxWidth="880" />
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding HasSession, Converter={StaticResource Conv.InvBoolVis}}">
            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="52" Height="52" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6" />
            <TextBlock Text="{DynamicResource Str.Plan.Empty}" Style="{StaticResource Storava.Text.Body}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding HasSession, Converter={StaticResource Conv.BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Findings to choose from -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Str.Plan.Candidates}"
                           Style="{StaticResource Storava.SectionLabel}" Margin="2,0,0,10" />

                <TextBlock Grid.Row="1" Text="{DynamicResource Str.Plan.NoCandidates}"
                           Style="{StaticResource Storava.Text.Body}" TextWrapping="Wrap"
                           VerticalAlignment="Top" MaxWidth="520" Opacity="0.75"
                           Visibility="{Binding HasCandidates, Converter={StaticResource Conv.InvBoolVis}}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasCandidates, Converter={StaticResource Conv.BoolVis}}">
                    <ItemsControl ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card UniformCornerRadius="14" Padding="18" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,14,0"
                                                  IsChecked="{Binding IsIncluded}"
                                                  IsEnabled="{Binding CanBePlanned}" />

                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <Grid Style="{StaticResource Storava.TitleRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                           Style="{StaticResource Storava.TitleRow.Text}" />
                                                <WrapPanel Grid.Column="1" Style="{StaticResource Storava.TitleRow.Tags}">
                                                    <Border Style="{StaticResource Storava.Badge.Risk}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding RiskText}" Style="{StaticResource Storava.Badge.Text}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Storava.Badge}" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Storava.Badge.Text}" />
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Storava.Text.Caption}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Storava.Text.Body}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Text="{DynamicResource Str.Plan.NotPlannable}"
                                                       Style="{StaticResource Storava.Text.Caption}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0" Opacity="0.8"
                                                       Visibility="{Binding CanBePlanned, Converter={StaticResource Conv.InvBoolVis}}" />

                                            <Border CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Background="#22F59E0B"
                                                    Visibility="{Binding HasWarning, Converter={StaticResource Conv.BoolVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" VerticalAlignment="Top"
                                                                             Margin="0,2,8,0" Foreground="{DynamicResource Storava.Brush.Warning}" />
                                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Storava.Text.Caption}"
                                                               TextWrapping="Wrap" MaxWidth="440" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" MinWidth="140" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Storava.Text.H1}"
                                                       HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="{DynamicResource Str.Recommendations.Reclaimable}"
                                                       Style="{StaticResource Storava.Text.Caption}" HorizontalAlignment="Right" />

                                            <ComboBox Margin="0,12,0,0" MinWidth="130" HorizontalAlignment="Right"
                                                      ItemsSource="{Binding AvailableActions}"
                                                      SelectedItem="{Binding SelectedAction}"
                                                      DisplayMemberPath="Label"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      materialDesign:HintAssist.Hint="{DynamicResource Str.Plan.Action}"
                                                      Visibility="{Binding CanBePlanned, Converter={StaticResource Conv.BoolVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Summary + ordered steps -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Storava.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ReclaimableText}" Style="{StaticResource Storava.Text.Display}"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="{DynamicResource Str.Plan.Summary.Reclaimable}"
                                   Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,16" />

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="{Binding StepCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Plan.Summary.Steps}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding HighestRiskText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Plan.Summary.HighestRisk}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding MoveCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Plan.Summary.Moves}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding DeleteCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Plan.Summary.Deletes}" Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Storava.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBox Text="{Binding GoalGb, UpdateSourceTrigger=LostFocus}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.Plan.Goal}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <TextBlock Text="{DynamicResource Str.Plan.Goal.Hint}" Style="{StaticResource Storava.Text.Caption}"
                                   TextWrapping="Wrap" Margin="2,6,0,0" />

                        <ProgressBar Value="{Binding GoalProgress, Mode=OneWay}" Minimum="0" Maximum="1"
                                     Height="6" Margin="0,12,0,0"
                                     Visibility="{Binding HasGoal, Converter={StaticResource Conv.BoolVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding MeetsGoal, Converter={StaticResource Conv.BoolVis}}">
                            <materialDesign:PackIcon Kind="TargetVariant" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Foreground="{DynamicResource Storava.Brush.Success}" />
                            <TextBlock Text="{DynamicResource Str.Plan.Goal.Met}" Style="{StaticResource Storava.Text.Body}"
                                       Foreground="{DynamicResource Storava.Brush.Success}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Background="#22EF4444"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource Conv.NullVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Top" Margin="0,2,8,0"
                                                         Foreground="{DynamicResource Storava.Brush.Danger}" />
                                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Storava.Text.Caption}"
                                           TextWrapping="Wrap" MaxWidth="300" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Str.Plan.Steps}"
                               Style="{StaticResource Storava.SectionLabel}" Margin="2,0,0,10" />

                    <TextBlock Grid.Row="1" Text="{DynamicResource Str.Plan.NoSteps}"
                               Style="{StaticResource Storava.Text.Caption}" TextWrapping="Wrap"
                               VerticalAlignment="Top" Opacity="0.75"
                               Visibility="{Binding HasSteps, Converter={StaticResource Conv.InvBoolVis}}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSteps, Converter={StaticResource Conv.BoolVis}}">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Storava.Card}" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0"
                                                        Background="{DynamicResource MaterialDesignChipBackground}">
                                                    <TextBlock Text="{Binding Order}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Style="{StaticResource Storava.Badge.Risk}">
                                                    <TextBlock Text="{Binding ActionText}" Style="{StaticResource Storava.Badge.Text}" />
                                                </Border>
                                                <TextBlock Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Storava.Text.Body}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Storava.Text.Caption}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding HasOfficialMethod, Converter={StaticResource Conv.BoolVis}}">
                                                <materialDesign:PackIcon Kind="CheckDecagramOutline" Width="15" Height="15"
                                                                         VerticalAlignment="Top" Margin="0,2,6,0"
                                                                         Foreground="{DynamicResource Storava.Brush.Success}" />
                                                <TextBlock Text="{DynamicResource Str.Plan.OfficialMethod}"
                                                           Style="{StaticResource Storava.Text.Caption}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding NeedsLink, Converter={StaticResource Conv.BoolVis}}">
                                                <materialDesign:PackIcon Kind="LinkVariant" Width="15" Height="15"
                                                                         VerticalAlignment="Top" Margin="0,2,6,0"
                                                                         Foreground="{DynamicResource Storava.Brush.Warning}" />
                                                <TextBlock Text="{DynamicResource Str.Plan.NeedsLink}"
                                                           Style="{StaticResource Storava.Text.Caption}"
                                                           TextWrapping="Wrap" MaxWidth="300" />
                                            </StackPanel>

                                            <!-- Counted as zero, and the reason is shown rather than silently dropped -->
                                            <Border CornerRadius="8" Padding="10,8" Margin="0,8,0,0"
                                                    Background="{DynamicResource MaterialDesignChipBackground}"
                                                    Visibility="{Binding IsCovered, Converter={StaticResource Conv.BoolVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Str.Plan.Covered}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{DynamicResource Str.Plan.Covered.Note}"
                                                               Style="{StaticResource Storava.Text.Caption}"
                                                               TextWrapping="Wrap" MaxWidth="300" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
