<UserControl x:Class="Storava.App.Views.Pages.ScanExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Storava.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str.Explorer.Title}" Style="{StaticResource Storava.Text.Display}" />
            <TextBlock Text="{Binding RootPathText}" Style="{StaticResource Storava.Text.Caption}" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,14"
              Visibility="{Binding HasData, Converter={StaticResource Conv.BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="{DynamicResource Str.Explorer.Search}"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" MaxWidth="520" HorizontalAlignment="Left">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Command="{Binding SearchCommand}" Margin="10,0,0,0" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                <materialDesign:PackIcon Kind="Magnify" />
            </Button>
            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Margin="8,0,0,0" Height="40"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="{DynamicResource Str.Explorer.Clear}" />
        </Grid>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasData, Converter={StaticResource Conv.InvBoolVis}}">
            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="52" Height="52" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6" />
            <TextBlock Text="{DynamicResource Str.Explorer.Empty}" Style="{StaticResource Storava.Text.Body}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" TextAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="2" Visibility="{Binding HasData, Converter={StaticResource Conv.BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Tabs -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="14" Padding="4">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            Style="{StaticResource MaterialDesignTabControl}"
                            Background="Transparent">
                    <!-- Tree -->
                    <TabItem Header="{DynamicResource Str.Explorer.Tree}">
                        <TreeView x:Name="Tree" ItemsSource="{Binding TreeRoots}"
                                  SelectedItemChanged="Tree_OnSelectedItemChanged"
                                  BorderThickness="0" Padding="6"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:ScanNodeViewModel}" ItemsSource="{Binding Children}">
                                    <Grid MinWidth="420">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                 Kind="{Binding Item.ItemType, Converter={StaticResource Conv.ItemIcon}}"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center"
                                                   Margin="12,0" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Margin="8,0,4,0" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </TabItem>

                    <!-- Largest -->
                    <TabItem Header="{DynamicResource Str.Explorer.Largest}">
                        <DataGrid ItemsSource="{Binding LargestItems}" SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="10,6" Margin="4">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource Str.Explorer.Col.Name}" Width="*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Margin="0,0,8,0"
                                                                         Kind="{Binding ItemType, Converter={StaticResource Conv.ItemIcon}}"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Str.Explorer.Col.Size}" Width="120"
                                                    Binding="{Binding Size, Converter={StaticResource Conv.Bytes}}" SortMemberPath="Size" />
                                <DataGridTextColumn Header="{DynamicResource Str.Explorer.Col.Modified}" Width="150"
                                                    Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="LastWriteTime" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Results -->
                    <TabItem Header="{DynamicResource Str.Explorer.Results}">
                        <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="10,6" Margin="4">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource Str.Explorer.Col.Name}" Width="*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center" Margin="0,0,8,0"
                                                                         Kind="{Binding ItemType, Converter={StaticResource Conv.ItemIcon}}"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Str.Explorer.Col.Size}" Width="120"
                                                    Binding="{Binding Size, Converter={StaticResource Conv.Bytes}}" SortMemberPath="Size" />
                                <DataGridTextColumn Header="{DynamicResource Str.Explorer.Col.Modified}" Width="150"
                                                    Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}" SortMemberPath="LastWriteTime" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>

            <!-- Detail pane -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="14" Padding="20" VerticalAlignment="Stretch">
                <Grid>
                    <!-- Empty -->
                    <TextBlock Text="{DynamicResource Str.Explorer.Detail.Empty}" Style="{StaticResource Storava.Text.Caption}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource Conv.NullVis}, ConverterParameter=invert}" />

                    <!-- Details -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedItem, Converter={StaticResource Conv.NullVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Explorer.Detail.Title}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"
                                                         Kind="{Binding SelectedItem.ItemType, Converter={StaticResource Conv.ItemIcon}}"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource Storava.Text.Body}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Str.Explorer.Detail.Path}" Style="{StaticResource Storava.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.Path}" Style="{StaticResource Storava.Text.Body}" Margin="0,2,0,12" TextWrapping="Wrap" />

                            <TextBlock Text="{DynamicResource Str.Explorer.Detail.Size}" Style="{StaticResource Storava.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.Size, Converter={StaticResource Conv.Bytes}}" Style="{StaticResource Storava.Text.Body}" Margin="0,2,0,12" />

                            <TextBlock Text="{DynamicResource Str.Explorer.Detail.OnDisk}" Style="{StaticResource Storava.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.AllocatedSize, Converter={StaticResource Conv.Bytes}}" Style="{StaticResource Storava.Text.Body}" Margin="0,2,0,12" />

                            <StackPanel Visibility="{Binding SelectedItem.IsFolder, Converter={StaticResource Conv.BoolVis}}">
                                <TextBlock Text="{DynamicResource Str.Explorer.Detail.Items}" Style="{StaticResource Storava.Text.Caption}" />
                                <TextBlock Style="{StaticResource Storava.Text.Body}" Margin="0,2,0,12">
                                    <Run Text="{Binding SelectedItem.FileCount, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedItem.FolderCount, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Str.Explorer.Detail.Modified}" Style="{StaticResource Storava.Text.Caption}" />
                            <TextBlock Text="{Binding SelectedItem.LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource Storava.Text.Body}" Margin="0,2,0,12" />

                            <Border Style="{StaticResource Storava.Badge}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Background="{StaticResource Storava.Brush.Risk.Protected}"
                                    Visibility="{Binding SelectedItem.IsProtected, Converter={StaticResource Conv.BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldLockOutline" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Str.Explorer.Detail.Protected}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Storava.Badge}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Background="{StaticResource Storava.Brush.Warning}"
                                    Visibility="{Binding SelectedItem.IsReparsePoint, Converter={StaticResource Conv.BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LinkVariant" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Str.Explorer.Detail.Reparse}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
