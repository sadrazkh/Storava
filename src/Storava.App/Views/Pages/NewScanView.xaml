<UserControl x:Class="Storava.App.Views.Pages.NewScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Pad.Page}" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NewScan.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.NewScan.Subtitle}" Style="{StaticResource Storava.Text.Caption}" Margin="0,4,0,18" />

                <!-- Drives -->
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.NewScan.ChooseDrive}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="220" Margin="0,0,12,12" Padding="14" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Root}"
                                            Style="{StaticResource Storava.DriveCardButton}"
                                            materialDesign:ButtonAssist.CornerRadius="12" Height="Auto">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Harddisk" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <materialDesign:PackIcon Kind="CheckCircle" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                         Visibility="{Binding IsSelected, Converter={StaticResource Conv.BoolVis}}" />
                                            </StackPanel>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}"
                                                         Height="6" Margin="0,10,0,6"
                                                         Foreground="{Binding BarColor, Converter={StaticResource Conv.Hex}}"
                                                         Background="{DynamicResource MaterialDesignDivider}" />
                                            <TextBlock Style="{StaticResource Storava.Text.Caption}" HorizontalAlignment="Left">
                                                <Run Text="{Binding UsedText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Str.NewScan.Target}" Style="{StaticResource Storava.Text.Caption}" Margin="0,10,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding BrowseCommand}" Margin="10,0,0,0" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Str.NewScan.Browse}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource Storava.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.NewScan.Mode}" Style="{StaticResource Storava.Text.H2}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.NewScan.Mode.Quick}" VerticalAlignment="Center" Style="{StaticResource Storava.Text.Body}" />
                            <ToggleButton IsChecked="{Binding IsDeep}" Margin="12,0" Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            <TextBlock Text="{DynamicResource Str.NewScan.Mode.Deep}" VerticalAlignment="Center" Style="{StaticResource Storava.Text.Body}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str.NewScan.Mode.Hint}" Style="{StaticResource Storava.Text.Caption}" Margin="0,8,0,0" />

                        <TextBlock Text="{DynamicResource Str.NewScan.Exclusions}" Style="{StaticResource Storava.Text.Caption}" Margin="0,18,0,6" />
                        <TextBox Text="{Binding ExcludedExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Str.NewScan.Exclusions.Hint}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding HasError, Converter={StaticResource Conv.BoolVis}}">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource Storava.Brush.Danger}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource Str.NewScan.InvalidPath}" Foreground="{StaticResource Storava.Brush.Danger}" Style="{StaticResource Storava.Text.Body}" VerticalAlignment="Center" />
                </StackPanel>

                <Button HorizontalAlignment="Left" Command="{Binding StartScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10" Height="44" Padding="26,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Str.NewScan.Start}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
