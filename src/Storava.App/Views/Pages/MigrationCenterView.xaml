<UserControl x:Class="Storava.App.Views.Pages.MigrationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str.Migration.Title}" Style="{StaticResource Storava.Text.Display}" />
                <TextBlock Text="{DynamicResource Str.Migration.Subtitle}" Style="{StaticResource Storava.Text.Caption}"
                           TextWrapping="Wrap" MaxWidth="760" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ResetCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="38" Padding="16,0" Margin="0,0,8,0"
                        Visibility="{Binding HasPreflight, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Migration.Reset}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding PreflightCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="38" Padding="16,0" Margin="0,0,8,0"
                        IsEnabled="{Binding IsPreflighting, Converter={StaticResource Conv.InvBool}}"
                        Visibility="{Binding HasPlan, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardCheckOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Migration.Preflight}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding StartCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10" Height="38" Padding="20,0"
                        Visibility="{Binding HasPreflight, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str.Migration.Start}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- What this page is allowed to do, stated before anything else -->
        <StackPanel Grid.Row="1">
            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12" Background="#22F59E0B">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="22" Height="22" VerticalAlignment="Top"
                                             Margin="0,1,12,0" Foreground="{DynamicResource Storava.Brush.Warning}" />
                    <TextBlock Text="{DynamicResource Str.Migration.SafetyNote}" Style="{StaticResource Storava.Text.Body}"
                               TextWrapping="Wrap" MaxWidth="920" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                    Background="{DynamicResource MaterialDesignChipBackground}"
                    Visibility="{Binding RecoveryNotice, Converter={StaticResource Conv.NullVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BackupRestore" Width="22" Height="22" VerticalAlignment="Top"
                                             Margin="0,1,12,0" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="{Binding RecoveryNotice}" Style="{StaticResource Storava.Text.Body}"
                               TextWrapping="Wrap" MaxWidth="920" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12" Background="#22EF4444"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource Conv.NullVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" VerticalAlignment="Top" Margin="0,2,10,0"
                                             Foreground="{DynamicResource Storava.Brush.Danger}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Storava.Text.Body}"
                               TextWrapping="Wrap" MaxWidth="920" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- No saved plan -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding HasPlan, Converter={StaticResource Conv.InvBoolVis}}">
            <materialDesign:PackIcon Kind="SwapHorizontal" Width="52" Height="52" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.6" />
            <TextBlock Text="{DynamicResource Str.Migration.NoPlan}" Style="{StaticResource Storava.Text.Body}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding HasPlan, Converter={StaticResource Conv.BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- Left: the step in hand, then the dry run -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The one step awaiting a decision -->
                <materialDesign:Card Grid.Row="0" UniformCornerRadius="14" Padding="20" Margin="0,0,0,14"
                                     Visibility="{Binding HasCurrentStep, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource Storava.Badge.Accent}">
                                <TextBlock Text="{Binding CurrentActionText}" Style="{StaticResource Storava.Badge.Text}" />
                            </Border>
                            <TextBlock Text="{Binding CurrentPositionText}" Style="{StaticResource Storava.Text.Caption}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding CurrentSizeText}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Storava.Text.H1}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Storava.Text.Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentRiskText}" Style="{StaticResource Storava.Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" />

                        <!-- Destination, for a move only -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding CurrentIsMove, Converter={StaticResource Conv.BoolVis}}">
                            <TextBlock Text="{DynamicResource Str.Migration.Destination}"
                                       Style="{StaticResource Storava.SectionLabel}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DestinationPreview, Mode=OneWay}"
                                         IsReadOnly="True" VerticalAlignment="Center"
                                         AutomationProperties.Name="{DynamicResource Str.Migration.Destination.Hint}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="{DynamicResource Str.Migration.Destination.Hint}" />
                                <Button Grid.Column="1" Command="{Binding PickDestinationCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="40" Padding="16,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Str.Migration.Browse}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{DynamicResource Str.Migration.Destination.Note}"
                                       Style="{StaticResource Storava.Text.Caption}" TextWrapping="Wrap"
                                       Margin="2,6,0,0" Opacity="0.8" />
                        </StackPanel>

                        <!-- Typing the folder's own name is the approval -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Storava.Text.Body}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Str.Migration.ConfirmPrompt}" />
                                <Run Text="{Binding RequiredConfirmationName, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,8,0,0" MaxWidth="380" HorizontalAlignment="Left"
                                     AutomationProperties.Name="{DynamicResource Str.Migration.ConfirmPrompt}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Str.Migration.ConfirmHint}" />
                        </StackPanel>

                        <!-- Live copy progress -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsExecuting, Converter={StaticResource Conv.BoolVis}}">
                            <ProgressBar Value="{Binding CopyFraction, Mode=OneWay}" Minimum="0" Maximum="1" Height="6" />
                            <TextBlock Text="{Binding CopyStatusText}" Style="{StaticResource Storava.Text.Caption}"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Command="{Binding RunStepCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="10" Height="40" Padding="22,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Str.Migration.RunStep}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SkipStepCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="40" Padding="18,0" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource Conv.InvBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DebugStepOver" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Str.Migration.Skip}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CancelStepCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="40" Padding="18,0" Margin="8,0,0,0"
                                    Foreground="{DynamicResource Storava.Brush.Danger}"
                                    Visibility="{Binding IsExecuting, Converter={StaticResource Conv.BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StopCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Str.Migration.Stop}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Dry run -->
                <Grid Grid.Row="1" Visibility="{Binding HasPreflight, Converter={StaticResource Conv.BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Str.Migration.DryRun}"
                               Style="{StaticResource Storava.SectionLabel}" Margin="2,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PreflightSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Storava.Card}" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                    VerticalAlignment="Top" Margin="0,2,12,0"
                                                    Background="{DynamicResource MaterialDesignChipBackground}">
                                                <TextBlock Text="{Binding Order}" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Style="{StaticResource Storava.Badge.Risk}">
                                                        <TextBlock Text="{Binding ActionText}" Style="{StaticResource Storava.Badge.Text}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Storava.Text.Body}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Storava.Text.Caption}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Why it cannot run, in the user's words -->
                                                <Border CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Background="#22EF4444"
                                                        Visibility="{Binding BlockerText, Converter={StaticResource Conv.NullVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="15" Height="15"
                                                                                 VerticalAlignment="Top" Margin="0,2,6,0"
                                                                                 Foreground="{DynamicResource Storava.Brush.Danger}" />
                                                        <TextBlock Text="{Binding BlockerText}" Style="{StaticResource Storava.Text.Caption}"
                                                                   TextWrapping="Wrap" MaxWidth="440" />
                                                    </StackPanel>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0"
                                                              Visibility="{Binding HasWarnings, Converter={StaticResource Conv.BoolVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <materialDesign:PackIcon Kind="AlertOutline" Width="14" Height="14"
                                                                                         VerticalAlignment="Top" Margin="0,3,6,0"
                                                                                         Foreground="{DynamicResource Storava.Brush.Warning}" />
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Storava.Text.Caption}"
                                                                           TextWrapping="Wrap" MaxWidth="440" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Top" Margin="12,2,0,0"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Right: totals and the record of what happened -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Storava.Card}" Margin="0,0,0,12"
                        Visibility="{Binding HasPreflight, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ReclaimableText}" Style="{StaticResource Storava.Text.Display}"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="{DynamicResource Str.Migration.Summary.Reclaimable}"
                                   Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,16" />

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding RunnableCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Migration.Summary.Runnable}"
                                           Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding BlockedCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Migration.Summary.Blocked}"
                                           Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Storava.Card}" Margin="0,0,0,12"
                        Visibility="{Binding HasLog, Converter={StaticResource Conv.BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FreedText}" Style="{StaticResource Storava.Text.Display}"
                                   Foreground="{DynamicResource Storava.Brush.Success}" />
                        <TextBlock Text="{DynamicResource Str.Migration.Summary.Freed}"
                                   Style="{StaticResource Storava.Text.Caption}" Margin="0,0,0,16" />

                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding CompletedCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Migration.Summary.Done}"
                                           Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding SkippedCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Migration.Summary.Skipped}"
                                           Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding FailedCountText}" Style="{StaticResource Storava.Text.H1}" />
                                <TextBlock Text="{DynamicResource Str.Migration.Summary.Failed}"
                                           Style="{StaticResource Storava.Text.Caption}" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                    Visibility="{Binding IsFinished, Converter={StaticResource Conv.BoolVis}}">
                            <materialDesign:PackIcon Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Foreground="{DynamicResource Storava.Brush.Success}" />
                            <TextBlock Text="{DynamicResource Str.Migration.Finished}" Style="{StaticResource Storava.Text.Body}"
                                       Foreground="{DynamicResource Storava.Brush.Success}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Visibility="{Binding HasLog, Converter={StaticResource Conv.BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Str.Migration.Log}"
                               Style="{StaticResource Storava.SectionLabel}" Margin="2,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Storava.Card}" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Style="{StaticResource Storava.Badge.Risk}">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Storava.Badge.Text}" />
                                                </Border>
                                                <TextBlock Text="{Binding ActionText}" Style="{StaticResource Storava.Text.Caption}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding FreedText}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Storava.Brush.Success}"
                                                           Visibility="{Binding WasCompleted, Converter={StaticResource Conv.BoolVis}}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Storava.Text.Body}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Storava.Text.Caption}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding HasDestination, Converter={StaticResource Conv.BoolVis}}">
                                                <materialDesign:PackIcon Kind="ArrowRightBottom" Width="14" Height="14"
                                                                         VerticalAlignment="Top" Margin="0,3,6,0"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                <TextBlock Text="{Binding DestinationPath}" Style="{StaticResource Storava.Text.Caption}"
                                                           TextWrapping="Wrap" MaxWidth="330" />
                                            </StackPanel>

                                            <!-- Where the original went, so it can be brought back -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding WasRecycled, Converter={StaticResource Conv.BoolVis}}">
                                                <materialDesign:PackIcon Kind="DeleteRestore" Width="14" Height="14"
                                                                         VerticalAlignment="Top" Margin="0,3,6,0"
                                                                         Foreground="{DynamicResource Storava.Brush.Success}" />
                                                <TextBlock Text="{DynamicResource Str.Migration.InRecycleBin}"
                                                           Style="{StaticResource Storava.Text.Caption}"
                                                           TextWrapping="Wrap" MaxWidth="330" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding HasLink, Converter={StaticResource Conv.BoolVis}}">
                                                <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14"
                                                                         VerticalAlignment="Top" Margin="0,3,6,0"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                <TextBlock Text="{DynamicResource Str.Migration.LinkLeft}"
                                                           Style="{StaticResource Storava.Text.Caption}"
                                                           TextWrapping="Wrap" MaxWidth="330" />
                                            </StackPanel>

                                            <Border CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Background="#22F59E0B"
                                                    Visibility="{Binding HasDetail, Converter={StaticResource Conv.BoolVis}}">
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Storava.Text.Caption}"
                                                           TextWrapping="Wrap" MaxWidth="340" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
