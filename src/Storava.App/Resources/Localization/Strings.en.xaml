    <sys:String x:Key="Str.Dashboard.Drives.Title">Drives</sys:String>
    <sys:String x:Key="Str.Dashboard.LastScan.Title">Last scan</sys:String>
    <sys:String x:Key="Str.Dashboard.LastScan.Empty">No scan yet. Start your first scan to see findings here.</sys:String>
    <sys:String x:Key="Str.Dashboard.Findings.Title">Top findings</sys:String>
    <sys:String x:Key="Str.Dashboard.Findings.Empty">Findings appear after a scan and local analysis.</sys:String>
    <sys:String x:Key="Str.Dashboard.Ai.Title">AI advisor</sys:String>
    <sys:String x:Key="Str.Dashboard.Ai.Disabled">Disabled — enable it in Settings to get smart reports.</sys:String>
    <sys:String x:Key="Str.Dashboard.Ai.Enabled">Enabled</sys:String>
    <sys:String x:Key="Str.Dashboard.StartScan">Start a scan</sys:String>

    <!-- Settings -->
    <sys:String x:Key="Str.Settings.Title">Settings</sys:String>
    <sys:String x:Key="Str.Settings.Subtitle">Personalize appearance, language and AI.</sys:String>
    <sys:String x:Key="Str.Settings.Appearance">Appearance</sys:String>
    <sys:String x:Key="Str.Settings.Language">Language</sys:String>
