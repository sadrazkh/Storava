    <!-- Welcome -->
    <sys:String x:Key="Str.Welcome.Title">Welcome to Storava</sys:String>
    <sys:String x:Key="Str.Welcome.Subtitle">Understand what fills your disk — and free space safely, on your terms.</sys:String>
    <sys:String x:Key="Str.Welcome.Safety.Title">Nothing is touched without you</sys:String>
    <sys:String x:Key="Str.Welcome.Safety.Body">Storava only analyzes, explains and plans. No file or folder is ever deleted, moved or renamed unless you select it and explicitly confirm. The AI can advise — it can never act.</sys:String>
    <sys:String x:Key="Str.Welcome.Feature1.Title">Analyze</sys:String>
    <sys:String x:Key="Str.Welcome.Feature1.Body">Scan drives, find heavy folders and understand the real cause of disk usage.</sys:String>
