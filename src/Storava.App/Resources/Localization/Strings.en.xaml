    <sys:String x:Key="Str.Settings.Save">Save changes</sys:String>
    <sys:String x:Key="Str.Settings.Saved">Settings saved.</sys:String>

    <!-- New Scan -->
    <sys:String x:Key="Str.NewScan.Title">New Scan</sys:String>
    <sys:String x:Key="Str.NewScan.Subtitle">Choose what to analyze. Storava reads only — it never changes your files.</sys:String>
