    <sys:String x:Key="Str.Category.WindowsSystem">سیستم ویندوز</sys:String>
    <sys:String x:Key="Str.Category.TemporaryFiles">فایل‌های موقت</sys:String>
    <sys:String x:Key="Str.Category.DeveloperTools">ابزارهای توسعه</sys:String>
    <sys:String x:Key="Str.Category.PackageCaches">کش پکیج‌ها</sys:String>
    <sys:String x:Key="Str.Category.BuildArtifacts">خروجی‌های بیلد</sys:String>
    <sys:String x:Key="Str.Category.Docker">داکر</sys:String>
    <sys:String x:Key="Str.Category.Wsl">WSL</sys:String>
    <sys:String x:Key="Str.Category.VirtualMachines">ماشین‌های مجازی</sys:String>
    <sys:String x:Key="Str.Category.AiModels">مدل‌های هوش مصنوعی</sys:String>
    <sys:String x:Key="Str.Category.Sdks">SDKها</sys:String>
    <sys:String x:Key="Str.Category.IdeCaches">کش IDEها</sys:String>
    <sys:String x:Key="Str.Category.BrowserCaches">کش مرورگرها</sys:String>
    <sys:String x:Key="Str.Category.GameLibraries">کتابخانه‌ی بازی‌ها</sys:String>
