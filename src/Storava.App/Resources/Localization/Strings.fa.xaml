<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="App.FontFamily">Vazirmatn, Segoe UI, Tahoma</FontFamily>

    <!-- App -->
    <sys:String x:Key="Str.App.Name">استوراوا</sys:String>
    <sys:String x:Key="Str.App.Tagline">هوش و مشاور فضای ذخیره‌سازی</sys:String>

