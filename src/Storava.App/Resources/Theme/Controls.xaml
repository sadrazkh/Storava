<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Surface card -->
    <!-- The one panel surface in the app.

         No drop shadow. A black shadow under a dark panel on a dark page does not read as raised,
         it reads as a dark halo around something sunken — which, nested inside a page margin and a
         column margin, is exactly how every panel looked. The border and the spacing carry the
         separation instead, and they do it the same way at every size. -->
    <Style x:Key="Storava.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Shown over a page while it is fetching something.

         Translucent rather than opaque on purpose: coming back to a page you have already seen
         keeps that page visible underneath while the newer data arrives, so the wait reads as the
         page refreshing rather than as the page having been thrown away. -->
    <Style x:Key="Storava.LoadingVeil" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Veil}" />
        <Setter Property="Panel.ZIndex" Value="50" />
        <!-- Nothing underneath should be clickable while it is covered: a button pressed against
             data that is about to be replaced acts on the old data. -->
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style x:Key="Storava.LoadingCard" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- Navigation rail item -->
    <Style x:Key="Storava.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="Accent"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MaterialDesignSelection}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MaterialDesignSelection}" />
                            <Setter TargetName="Accent" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small uppercase section label -->
    <Style x:Key="Storava.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
        <Setter Property="Margin" Value="14,16,14,6" />
    </Style>

    <!-- Selectable drive tile: quiet by default, accent-outlined and tinted when chosen -->
    <Style x:Key="Storava.DriveCardButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesignSelection}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Tags.

         A tag is a tinted fill, a legible label and a quiet border, and
         all three come from one palette entry. The previous version was a
         999-radius lozenge filled with a saturated hue under white text —
         wrong shape, and the label sat at about 2:1 contrast.

         DynamicResource throughout: these brushes are swapped wholesale
         when the theme changes, and a StaticResource would keep the dark
         colours on a light window.
         ============================================================ -->
    <Style x:Key="Storava.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tag}" />
        <!-- Three above and below, not two: Persian descenders (ج, چ, ی) drop below the
             baseline and were reaching the border. -->
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Neutral.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Neutral.Edge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Neutral.Text}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <!-- A title with tags beside it.

         A horizontal StackPanel is the wrong container for this and was the bug: it gives its
         first child unlimited width, so a long title took the whole row and pushed the tags past
         the edge of the card, where they were clipped away. The title is the part that can afford
         to lose characters, so it gets the flexible column and an ellipsis, and the tags keep the
         space they need. -->
    <Style x:Key="Storava.TitleRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- The title inside such a row.

         Capped rather than left to grow. Its column sizes to the text so the tags sit next to the
         title where they belong instead of drifting to the far edge of the card, and the cap is
         what stops a long title reaching them: past this width it truncates. -->
    <Style x:Key="Storava.TitleRow.Text" TargetType="TextBlock" BasedOn="{StaticResource Storava.Text.H2}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- The tags in such a row. Wraps rather than clips when the row is genuinely too narrow. -->
    <Style x:Key="Storava.TitleRow.Tags" TargetType="WrapPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- The label inside a tag. Inherits the tag's colour rather than naming one, so a tag
         only ever has to be given its meaning once. -->
    <Style x:Key="Storava.Badge.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A tag that colours itself from a RiskLevel, so no view picks risk colours by hand
         and no view can pick a different set than its neighbour. -->
    <Style x:Key="Storava.Badge.Risk" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Risk}" Value="Low">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Risk.Low.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Risk.Low.Edge}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Risk.Low.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="Medium">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Risk.Medium.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Risk.Medium.Edge}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Risk.Medium.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="High">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Risk.High.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Risk.High.Edge}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Risk.High.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="Protected">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Risk.Protected.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Risk.Protected.Edge}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Risk.Protected.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="Unknown">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Risk.Unknown.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Risk.Unknown.Edge}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Risk.Unknown.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- ============================================================
         A row in a list of things to act on.

         Flatter and quieter than a card. The previous list used Material's Card with its own
         elevation and padding, nested inside a page margin and a column margin, so every row sat
         visibly inset from the panel around it and the whole list read as sunken. A row is not a
         floating object; it is a line in a list, and it only needs a surface and an edge.
         ============================================================ -->
    <Style x:Key="Storava.Row" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ============================================================
         The step chips across the top.

         Tag carries whether this is the step on screen. A DataTrigger on Tag rather than a bound
         Background keeps the two states defined together in one place, so the active and inactive
         appearance can never drift apart across three call sites.
         ============================================================ -->
    <Style x:Key="Storava.Step" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
        <Style.Triggers>
            <!-- Reads IsActive off the chip's own DataContext. The previous arrangement went
                 through the Border's Tag, which is typed object, so the bound bool was compared
                 against the literal string "True" and the trigger never fired at all. -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Step.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Step.Edge}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Step.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The numbered disc in a step chip. Round on purpose — it is a number, not a label. -->
    <Style x:Key="Storava.Step.Number" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Margin" Value="0,0,9,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
        <Style.Triggers>
            <!-- The same property the chip reads, so the two cannot disagree. -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Storava.Brush.Step.Edge}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Storava.Step.NumberText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Storava.Step.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         A filter chip: a tag you can press.

         It carries the same shape and colours as the tag it filters by, so the connection between
         "these rows are tagged low risk" and "show me the low risk ones" needs no explaining. The
         checked state is filled rather than outlined, because a filter that is on has to be
         obvious from the shape of the row, not from a subtlety.
         ============================================================ -->
    <Style x:Key="Storava.FilterChip" TargetType="ToggleButton">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Storava.Brush.Neutral.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chip"
                            CornerRadius="{StaticResource Radius.Tag}"
                            BorderThickness="1"
                            Background="{DynamicResource Storava.Brush.Neutral.Fill}"
                            BorderBrush="{DynamicResource Storava.Brush.Neutral.Edge}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush"
                                    Value="{DynamicResource Storava.Brush.Step.Edge}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background"
                                    Value="{DynamicResource Storava.Brush.Step.Fill}" />
                            <Setter TargetName="Chip" Property="BorderBrush"
                                    Value="{DynamicResource Storava.Brush.Step.Edge}" />
                            <Setter Property="Foreground" Value="{DynamicResource Storava.Brush.Step.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A fixed protected tag, for the places that state "this is protected" outright rather
         than carrying a risk level to colour themselves from. Explicit, because a risk-triggered
         style over a model with no risk to read silently falls back to neutral. -->
    <Style x:Key="Storava.Badge.Protected" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Risk.Protected.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Risk.Protected.Edge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Risk.Protected.Text}" />
    </Style>

    <Style x:Key="Storava.Badge.Success" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Success.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Success.Edge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Success.Text}" />
    </Style>

    <Style x:Key="Storava.Badge.Warning" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Warning.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Warning.Edge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Warning.Text}" />
    </Style>

    <Style x:Key="Storava.Badge.Danger" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Danger.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Danger.Edge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Danger.Text}" />
    </Style>

    <!-- The accent tag keeps MaterialDesign's own foreground for the primary hue, which is
         computed for contrast against whatever accent the user picked in settings — something a
         fixed white cannot be. -->
    <Style x:Key="Storava.Badge.Accent" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
    </Style>

    <Style x:Key="Storava.Badge.Info" TargetType="Border" BasedOn="{StaticResource Storava.Badge}">
        <Setter Property="Background" Value="{DynamicResource Storava.Brush.Info.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Storava.Brush.Info.Edge}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Storava.Brush.Info.Text}" />
    </Style>

    <!-- Copy this path, or open it where it lives.

         One template so the pair looks and behaves the same everywhere, and so a page that shows a
         path cannot end up with only half of it. Both commands come off the shell through the
         window, which every page is inside; the path itself comes from whatever the row is bound
         to, passed in as the Tag.

         Icon-only, with tooltips: these sit at the end of rows that are already carrying a name, a
         size and a reason, and two more words of button text on each would crowd out the content
         they are pointing at. -->
    <DataTemplate x:Key="Storava.PathActions">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource MaterialDesignIconButton}"
                    Width="30" Height="30" Padding="0"
                    ToolTip="{DynamicResource Str.Common.Path.Copy}"
                    Command="{Binding DataContext.Paths.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
            </Button>

            <Button Style="{StaticResource MaterialDesignIconButton}"
                    Width="30" Height="30" Padding="0"
                    ToolTip="{DynamicResource Str.Common.Path.Reveal}"
                    Command="{Binding DataContext.Paths.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" />
            </Button>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
