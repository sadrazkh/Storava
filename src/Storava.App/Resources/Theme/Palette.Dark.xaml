<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Storava semantic palette — dark.

         Every semantic colour comes in three parts, because a status tag
         needs all three and picking them separately per view is how a
         palette drifts:

           Fill  the tag's background, a tint of the hue over the surface
           Text  the label, held to WCAG AA (4.5:1) against that Fill
           Edge  the boundary, decoration over meaning the text already
                 carries, so it only has to be visible

         The previous design filled a tag with the saturated hue and wrote
         white on top. That reads at 2.15:1 for the amber and 2.28:1 for
         the green — barely legible, and the reason the tags looked wrong
         as much as their shape did.

         Light has its own file with the same keys; ThemeService swaps
         between them, so everything here must be referenced with
         DynamicResource or it will not follow the theme.
         ============================================================ -->

    <!-- Risk: Low -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Low.Fill" Color="#143222" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Low.Text" Color="#4ADE80" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Low.Edge" Color="#377950" />

    <!-- Risk: Medium -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Medium.Fill" Color="#332815" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Medium.Text" Color="#FBBF24" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Medium.Edge" Color="#8A661A" />

    <!-- Risk: High -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.High.Fill" Color="#3A1E1E" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.High.Text" Color="#F87171" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.High.Edge" Color="#9C4444" />

    <!-- Risk: Protected. Blue-grey rather than a warmer warning colour: this is not
         "dangerous", it is "not yours to move", and it should not compete with High. -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Protected.Fill" Color="#1F2937" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Protected.Text" Color="#9DB4D0" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Protected.Edge" Color="#445C7E" />

    <!-- Risk: Unknown -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Unknown.Fill" Color="#2A2A2F" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Unknown.Text" Color="#A8A8B2" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Unknown.Edge" Color="#50505A" />

    <!-- Status, for messages and outcomes rather than risk -->
    <SolidColorBrush x:Key="Storava.Brush.Info.Fill" Color="#16283C" />
    <SolidColorBrush x:Key="Storava.Brush.Info.Text" Color="#7DB4F5" />
    <SolidColorBrush x:Key="Storava.Brush.Info.Edge" Color="#35618C" />

    <SolidColorBrush x:Key="Storava.Brush.Success.Fill" Color="#143222" />
    <SolidColorBrush x:Key="Storava.Brush.Success.Text" Color="#4ADE80" />
    <SolidColorBrush x:Key="Storava.Brush.Success.Edge" Color="#377950" />

    <SolidColorBrush x:Key="Storava.Brush.Warning.Fill" Color="#332815" />
    <SolidColorBrush x:Key="Storava.Brush.Warning.Text" Color="#FBBF24" />
    <SolidColorBrush x:Key="Storava.Brush.Warning.Edge" Color="#8A661A" />

    <SolidColorBrush x:Key="Storava.Brush.Danger.Fill" Color="#3A1E1E" />
    <SolidColorBrush x:Key="Storava.Brush.Danger.Text" Color="#F87171" />
    <SolidColorBrush x:Key="Storava.Brush.Danger.Edge" Color="#9C4444" />

    <!-- A neutral tag, for facts that carry no judgement: a category name, a capability. -->
    <SolidColorBrush x:Key="Storava.Brush.Neutral.Fill" Color="#26262A" />
    <SolidColorBrush x:Key="Storava.Brush.Neutral.Text" Color="#B4B4BE" />
    <SolidColorBrush x:Key="Storava.Brush.Neutral.Edge" Color="#3C3C44" />


    <!-- ============================================================
         Flat accents: an icon or a line of text sitting directly on a
         card, not inside a tag. Same hues, but contrast-checked against
         the card surface rather than against a tag fill — the two are
         different backgrounds and a colour that passes on one can fail
         on the other.
         ============================================================ -->
    <SolidColorBrush x:Key="Storava.Brush.Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="Storava.Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Storava.Brush.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Storava.Brush.Info" Color="#7DB4F5" />
    <SolidColorBrush x:Key="Storava.Brush.Muted" Color="#A8A8B2" />


    <!-- The step the user is on. Its own tokens, contrast-checked in both themes. -->
    <SolidColorBrush x:Key="Storava.Brush.Step.Fill" Color="#0E3B39" />
    <SolidColorBrush x:Key="Storava.Brush.Step.Text" Color="#5EEAD4" />
    <SolidColorBrush x:Key="Storava.Brush.Step.Edge" Color="#2A8079" />

    <!-- Dims a page while it loads, without hiding what is already on it. -->
    <SolidColorBrush x:Key="Storava.Brush.Veil" Color="#C4101418" />

    <!-- Hero gradient. Every stop is dark enough to carry white text: the teal it started from
         read at 2.55:1 under the headline it was behind, which is the page's largest type and
         the first thing anyone sees. -->
    <LinearGradientBrush x:Key="Storava.Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E7C77" Offset="0" />
        <GradientStop Color="#0E5F73" Offset="0.55" />
        <GradientStop Color="#1B2432" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
