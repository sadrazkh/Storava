<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Storava semantic palette — light.

         The same keys as Palette.Dark.xaml, and they must stay the same:
         ThemeService swaps one file for the other, so a key present in
         only one theme becomes a missing-resource crash the moment the
         user switches.

         Not the dark values lightened. A hue readable on a dark surface
         is usually too pale on a white one, so each Text here is a darker
         shade of its hue and each Fill a paler tint. All 18 pairs are
         checked against WCAG AA for the label.
         ============================================================ -->

    <!-- Risk: Low -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Low.Fill" Color="#E2F5EA" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Low.Text" Color="#14713A" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Low.Edge" Color="#7FCB9F" />

    <!-- Risk: Medium -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Medium.Fill" Color="#FBEFD9" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Medium.Text" Color="#8F5407" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Medium.Edge" Color="#DDB068" />

    <!-- Risk: High -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.High.Fill" Color="#FBE7E7" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.High.Text" Color="#B91C1C" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.High.Edge" Color="#E79494" />

    <!-- Risk: Protected -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Protected.Fill" Color="#E9EEF5" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Protected.Text" Color="#43506A" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Protected.Edge" Color="#A4B4C9" />

    <!-- Risk: Unknown -->
    <SolidColorBrush x:Key="Storava.Brush.Risk.Unknown.Fill" Color="#EFEFF2" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Unknown.Text" Color="#4C4C55" />
    <SolidColorBrush x:Key="Storava.Brush.Risk.Unknown.Edge" Color="#B5B5BE" />

    <!-- Status -->
    <SolidColorBrush x:Key="Storava.Brush.Info.Fill" Color="#E3EEFC" />
    <SolidColorBrush x:Key="Storava.Brush.Info.Text" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Storava.Brush.Info.Edge" Color="#93B8F0" />

    <SolidColorBrush x:Key="Storava.Brush.Success.Fill" Color="#E2F5EA" />
    <SolidColorBrush x:Key="Storava.Brush.Success.Text" Color="#14713A" />
    <SolidColorBrush x:Key="Storava.Brush.Success.Edge" Color="#7FCB9F" />

    <SolidColorBrush x:Key="Storava.Brush.Warning.Fill" Color="#FBEFD9" />
    <SolidColorBrush x:Key="Storava.Brush.Warning.Text" Color="#8F5407" />
    <SolidColorBrush x:Key="Storava.Brush.Warning.Edge" Color="#DDB068" />

    <SolidColorBrush x:Key="Storava.Brush.Danger.Fill" Color="#FBE7E7" />
    <SolidColorBrush x:Key="Storava.Brush.Danger.Text" Color="#B91C1C" />
    <SolidColorBrush x:Key="Storava.Brush.Danger.Edge" Color="#E79494" />

    <!-- Neutral -->
    <SolidColorBrush x:Key="Storava.Brush.Neutral.Fill" Color="#F1F1F4" />
    <SolidColorBrush x:Key="Storava.Brush.Neutral.Text" Color="#4C4C55" />
    <SolidColorBrush x:Key="Storava.Brush.Neutral.Edge" Color="#D5D5DC" />


    <!-- ============================================================
         Flat accents: an icon or a line of text sitting directly on a
         card, not inside a tag. Same hues, but contrast-checked against
         the card surface rather than against a tag fill — the two are
         different backgrounds and a colour that passes on one can fail
         on the other.
         ============================================================ -->
    <SolidColorBrush x:Key="Storava.Brush.Success" Color="#14713A" />
    <SolidColorBrush x:Key="Storava.Brush.Warning" Color="#8F5407" />
    <SolidColorBrush x:Key="Storava.Brush.Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="Storava.Brush.Info" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Storava.Brush.Muted" Color="#4C4C55" />

    <!-- Hero gradient. Every stop is dark enough to carry white text: the teal it started from
         read at 2.55:1 under the headline it was behind, which is the page's largest type and
         the first thing anyone sees. -->
    <LinearGradientBrush x:Key="Storava.Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0C706C" Offset="0" />
        <GradientStop Color="#0B5568" Offset="0.55" />
        <GradientStop Color="#161F2B" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
