<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 4px spacing scale -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Tags. A pill radius on a short element makes a lozenge, which is what the status
         tags used to be; at this size a small radius reads as a tag instead. -->
    <CornerRadius x:Key="Radius.Tag">5</CornerRadius>

    <!-- Common paddings/margins -->
    <Thickness x:Key="Pad.Page">28,24,28,24</Thickness>
    <Thickness x:Key="Pad.Card">20</Thickness>
    <Thickness x:Key="Margin.Stack.S">0,0,0,8</Thickness>
    <Thickness x:Key="Margin.Stack.M">0,0,0,12</Thickness>
    <Thickness x:Key="Margin.Stack.L">0,0,0,20</Thickness>

</ResourceDictionary>
