<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Storava.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Storava</AssemblyName>
    <ApplicationIcon>storava.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The treemap layout algorithm is internal but worth testing directly. -->
    <InternalsVisibleTo Include="Storava.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="MaterialDesignColors" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storava.Domain\Storava.Domain.csproj" />
    <ProjectReference Include="..\Storava.Contracts\Storava.Contracts.csproj" />
    <ProjectReference Include="..\Storava.Application\Storava.Application.csproj" />
    <ProjectReference Include="..\Storava.Infrastructure\Storava.Infrastructure.csproj" />
    <ProjectReference Include="..\Storava.Platform\Storava.Platform.csproj" />
    <ProjectReference Include="..\Storava.Rules\Storava.Rules.csproj" />
    <ProjectReference Include="..\Storava.Migrations\Storava.Migrations.csproj" />
    <ProjectReference Include="..\Storava.AI\Storava.AI.csproj" />
    <ProjectReference Include="..\Storava.Reporting\Storava.Reporting.csproj" />
  </ItemGroup>

</Project>
